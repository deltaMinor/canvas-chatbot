# Enforce LF line endings for all text files
* text=auto eol=lf

# Force specific types to LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.java text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.env text eol=lf
*.env.* text eol=lf
*.lock text eol=lf

# Binary file types - DO NOT NORMALIZE
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.webp binary
*.avif binary
*.bmp binary
*.tiff binary
*.tif binary

# Font files
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archive files
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# Media files
*.mp4 binary
*.mp3 binary
*.wav binary
*.avi binary
*.mov binary
*.wmv binary
*.flv binary
*.webm binary
*.ogg binary

# Document files
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Executable files
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Git LFS files (if using Git LFS)
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
*.sketch filter=lfs diff=lfs merge=lfs -text

# Language-specific attributes
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.json linguist-language=JSON
*.css linguist-language=CSS
*.scss linguist-language=SCSS
*.sass linguist-language=Sass
*.html linguist-language=HTML
*.md linguist-language=Markdown
*.yml linguist-language=YAML
*.yaml linguist-language=YAML
*.sh linguist-language=Shell
*.bash linguist-language=Shell
*.ps1 linguist-language=PowerShell
*.py linguist-language=Python
*.java linguist-language=Java
*.c linguist-language=C
*.cpp linguist-language=C++
*.h linguist-language=C
*.hpp linguist-language=C++

# Generated files
*.min.js linguist-generated=true
*.min.css linguist-generated=true
*.bundle.js linguist-generated=true
*.chunk.js linguist-generated=true
dist/* linguist-generated=true
build/* linguist-generated=true
coverage/* linguist-generated=true
test-results/* linguist-generated=true
playwright-report/* linguist-generated=true

# Documentation
README.md linguist-documentation
CHANGELOG.md linguist-documentation
LICENSE linguist-documentation
*.md linguist-documentation
docs/* linguist-documentation

# Configuration files
*.config.js linguist-language=JavaScript
*.config.ts linguist-language=TypeScript
*.config.mjs linguist-language=JavaScript
*.config.cjs linguist-language=JavaScript
tailwind.config.js linguist-language=JavaScript
vite.config.js linguist-language=JavaScript
postcss.config.js linguist-language=JavaScript
playwright.config.ts linguist-language=TypeScript
eslint.config.mjs linguist-language=JavaScript
