{
    "name": "tm-frontend",
    "version": "25.16.0",
    "description": "",
    "private": true,
    "author": "iarcs",
    "license": "",
    "keywords": [
        "vite",
        "react"
    ],
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "vite build",
        "build:prod-preview": "vite build --mode production",
        "build:cloud-dev": "vite build --mode production",
        "build:cloud-stg": "vite build --mode production",
        "build:cloud-prod": "vite build --mode production",
        "build:userstudy": "vite build --mode production",
        "preview": "vite preview",
        "serve": "serve -s dist -l 3000",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx --cache --max-warnings=0",
        "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --cache --fix",
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "type-check": "tsc --noEmit",
        "clean": "rimraf dist coverage test-results playwright-report",
        "clean:deps": "rimraf node_modules package-lock.json",
        "install:clean": "npm run clean:deps && npm install",
        "pre-commit": "lint-staged",
        "validate": "npm run type-check && npm run lint && npm run test",
        "validate:ci": "npm run type-check && npm run lint && npm run test:coverage && npm run test:e2e",
        "sw:build": "workbox injectManifest workbox.config.js",
        "sw:clean": "rimraf dist/precache-manifest.*.js dist/serviceWorker.js",
        "sw:replace": "npm run sw:build && npm run sw:clean"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
