# Frontend Local Development Environment Configuration

# Environment Configuration
ENV_KEY=local.dev
ENV_TYPE=dev
NODE_ENV=development
VITE_MODE=development

# Application Configuration
LOCALE=local
VITE_DISABLE_PWA_PLUGIN=TRUE
VITE_REACT_APP_VERSION=25.16.0
VITE_REACT_APP_ENV=dev

# Server Configuration
# This demo removes the nginx reverse proxy - the Vite dev server is opened
# directly (see vite.config.mts's `server.proxy`, which forwards /api to the
# backend below). The port is shifted away from Vite's usual 3000/5173
# default so it doesn't collide with a full/original tm-project checkout (or
# anything else) that might already be running on that port.
VITE_PROTOCOL=tcp
VITE_HOST=0.0.0.0
VITE_PORT=39173
VITE_API_PROXY_TARGET=http://localhost:39006

# API Configuration
VITE_API_URL_PREFIX_APPLICATION=api/v1/application
VITE_API_URL_PREFIX_AD=api/v1/architecture_diagram

# Brand Configuration
VITE_BRAND_NAME=Diagram Canvas Chatbot Demo
VITE_BRAND_NAME_SHORT=Diagram Chatbot Demo
