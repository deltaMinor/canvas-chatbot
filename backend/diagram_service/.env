# Minimal environment for the single collapsed backend service in this demo.
# (The full application splits this across multiple .env / .secret.env
# files for several microservices - this demo only ever runs one.)
#
# Ports here are deliberately shifted into the 39xxx range (see
# docker-compose.yml) so this demo doesn't collide with a full/original
# tm-project checkout - or anything else - that might be running on the
# same machine using the usual defaults (27017, 6379, 5672, 8006, 3000...).

ENV_KEY=local.dev
ENV_TYPE=dev
ENV_LOCALE=local

MODULE_SHARED_LIBS_VERSION=1.4.2

# Hosts
# -------------------------------
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGIN_HOSTS=http://127.0.0.1:39173,http://localhost:39173
REACT_URL=http://127.0.0.1:39173
REACT_PORT=39173
DEBUG=1
SKIP_HEALTH_CHECK=1

# MongoDB
# -------------------------------
# Point this at a real MongoDB instance, e.g.
# `docker compose up -d tm-mongodb` (see docker-compose.yml), or your own
# local/Compass-visible instance.
DB_URL_MONGODB=mongodb://localhost:39017
AD_DB_NAME=tm_ad_db
REQUIRE_DB_AUTH=FALSE

# Redis
# -------------------------------
# Required: the (already dev-bypassed) auth decorator still pings Redis.
REDIS_URL_BASE=redis://localhost:39379/
REQUIRE_REDIS_AUTH=FALSE
REQUIRE_REDIS_TLS=FALSE

# Message queue (Celery broker - required, not optional)
# -------------------------------
# This codebase's data-access layer dispatches every MongoDB read/write as a
# Celery task via `send_task(name, ...)` (by task name), which requires a
# real, reachable broker and a worker actually consuming `diagram_queue`.
# Run RabbitMQ (e.g. `docker compose up -d tm-rabbitmq`) and a worker
# (`uv run celery -A main worker -Q diagram_queue`) alongside the web server.
MQ_URL_BASE_PRIMARY=amqp://guest:guest@localhost:39672/
REQUIRE_MQ_TLS=FALSE
REQUIRE_MQ_AUTH=FALSE

# Celery
# -------------------------------
CELERY_ENABLE_UTC=True
CELERY_TIMEZONE=UTC

# Service
# -------------------------------
DJANGO_SERVICE_AD_NAME=diagram_service
DJANGO_SERVICE_AD_PORT_EXPOSED=39006
DJANGO_SERVICE_AD_PROTOCOL=http
APP_LOGGER_LEVEL=DEBUG
UVICORN_LOG_LEVEL=INFO
UVICORN_WORKERS=1
UVICORN_THREAD_POOL_WORKERS=8
UVICORN_TIMEOUT_KEEP_ALIVE=5
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30

# Chatbot / IntentRX
# -------------------------------
# See the "IntentRX Setup" section of the root README.
# INTENTRX_ROOT=
# INTENTRX_PYTHON=

# LLM (only relevant if you re-enable the non-chatbot LLM generation code
# paths that this demo doesn't wire up in the frontend)
# -------------------------------
LLM_MODEL_EXECUTION_MODE_DEFAULT=api
LLM_ALLOWED_MODELS=openai_gpt_5_2
DEFAULT_LLM_MODEL=openai_gpt_5_2
