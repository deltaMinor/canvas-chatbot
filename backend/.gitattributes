# Enforce LF line endings for all text files
* text=auto eol=lf

# Force specific types to LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.sh text eol=lf

# Binary file types - DO NOT NORMALIZE
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.gz binary
*.tar binary
