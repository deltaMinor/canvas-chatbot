  <soda:hasContext rdf:resource="ComputeDescription"/>
  <term:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The TOSCA Compute node represents one or more processors of software applications or services along with other essential local resources. Collectively, the resources represented by a compute node can logically be viewed as a (real or virtual) “server”.</term:description>
</owl:Class>

